# Copy this file to .env and fill in real values. Never commit .env.

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Optional: set real Gemini prices (USD per 1M tokens) to enable cost tracking.
GEMINI_INPUT_PRICE_PER_M=0.0
GEMINI_OUTPUT_PRICE_PER_M=0.0

# Comma-separated list of accepted keys. Empty means every request is rejected.
# Use a long random value in production, never the development key.
API_KEYS=dev-key-123

# Local development Redis. Docker Compose overrides this to redis://redis:6379.
REDIS_URL=redis://localhost:6379

MAX_JOBS_PER_USER=3
JOB_TIMEOUT_SECS=300
JOB_TTL_SECS=3600
MAX_TOKENS_PER_JOB=50000
MAX_COST_USD_PER_JOB=0.50
DEBUG=true
